# Copy this file to ".env" and fill in your real values.
# NEVER put real keys in this file. It gets uploaded to GitHub.

# ---- Anthropic (Claude) ----
ANTHROPIC_API_KEY=

# ---- Second AI provider (OpenAI) ----
OPENAI_API_KEY=

# ---- Supabase (database) ----
# The URL looks like: https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service role key has full admin power over your database.
# Only use it in server code. Never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Netlify (publishing releases) ----
# Listed here by name only. The real values live ONLY in GitHub Secrets
# (the "release" environment). Never put their values in any file, including .env.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
